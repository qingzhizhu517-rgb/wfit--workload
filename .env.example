# ============================================================
# WFIT Workload 环境变量样例
#
# 用法：复制为 .env 并填入真实值。.env 已被 .gitignore 排除，切勿入库。
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# 注入方式（三选一）：
#   1) IDEA: Run/Debug Configurations -> 你的启动配置 -> Environment variables
#      粘贴形如  WFIT_DB_PASSWORD=xxx;WFIT_TOKEN_SECRET=yyy
#      （或安装 EnvFile 插件直接读取本文件同级的 .env）
#   2) PowerShell: $env:WFIT_DB_PASSWORD='xxx'  后再 mvn spring-boot:run
#   3) 部署环境：由容器/systemd/CI 的 secret 机制注入
#
# 凡下方未给默认值的变量（DB/Druid 口令、TOKEN_SECRET），
# 未注入时后端启动会直接失败 —— 这是刻意设计，避免沿用弱口令而不自知。
# ============================================================

# ---- 数据库（application-druid.yml）----
WFIT_DB_HOST=127.0.0.1
WFIT_DB_PORT=3306
WFIT_DB_NAME=wflg_workload
# 建议使用仅授权 wflg_workload 库的专用账号，不要用 root
WFIT_DB_USER=wfit
WFIT_DB_PASSWORD=

# ---- Druid 监控台（application-druid.yml）----
# 原框架默认 ruoyi/123456 全网皆知，务必改掉；生产环境建议直接关闭该页
WFIT_DRUID_USER=admin
WFIT_DRUID_PASSWORD=

# ---- JWT 令牌密钥（application.yml token.secret）----
# HS512 要求至少 64 字节。生成：openssl rand -base64 48
# 泄露即可伪造任意用户（含 admin）令牌绕过登录，等同于万能钥匙。
# 更换该值会使所有已发放令牌立即失效，全部用户需重新登录。
WFIT_TOKEN_SECRET=

# ---- Redis（application.yml，本机无密码可留空）----
WFIT_REDIS_HOST=localhost
WFIT_REDIS_PORT=6379
WFIT_REDIS_PASSWORD=

# ---- 业务配置：导入新建教师账号的初始密码 ----
# 非密钥，教师首次登录后须自行改密。不填则用 application.yml 默认值 123456
WFIT_DEFAULT_PASSWORD=
