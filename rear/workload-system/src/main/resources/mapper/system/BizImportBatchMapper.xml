<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.workload.system.mapper.BizImportBatchMapper">
    
    <resultMap type="BizImportBatch" id="BizImportBatchResult">
        <result property="id"    column="id"    />
        <result property="batchNo"    column="batch_no"    />
        <result property="importType"    column="import_type"    />
        <result property="fileName"    column="file_name"    />
        <result property="fileUrl"    column="file_url"    />
        <result property="totalCount"    column="total_count"    />
        <result property="successCount"    column="success_count"    />
        <result property="failCount"    column="fail_count"    />
        <result property="status"    column="status"    />
        <result property="errorSummary"    column="error_summary"    />
        <result property="templateVersion"    column="template_version"    />
        <result property="sourceHash"    column="source_hash"    />
        <result property="operatorId"    column="operator_id"    />
        <result property="operatorName"    column="operator_name"    />
        <result property="confirmTokenHash"    column="confirm_token_hash"    />
        <result property="confirmedAt"    column="confirmed_at"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectBizImportBatchVo">
        select id, batch_no, import_type, file_name, file_url, total_count, success_count, fail_count, status, error_summary, template_version, source_hash, operator_id, operator_name, confirm_token_hash, confirmed_at, create_by, create_time, update_by, update_time, remark from biz_import_batch
    </sql>

    <select id="selectBizImportBatchList" parameterType="BizImportBatch" resultMap="BizImportBatchResult">
        <include refid="selectBizImportBatchVo"/>
        <where>  
            <if test="batchNo != null  and batchNo != ''"> and batch_no = #{batchNo}</if>
            <if test="importType != null  and importType != ''"> and import_type = #{importType}</if>
            <if test="fileName != null  and fileName != ''"> and file_name like concat('%', #{fileName}, '%')</if>
            <if test="fileUrl != null  and fileUrl != ''"> and file_url = #{fileUrl}</if>
            <if test="totalCount != null "> and total_count = #{totalCount}</if>
            <if test="successCount != null "> and success_count = #{successCount}</if>
            <if test="failCount != null "> and fail_count = #{failCount}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="errorSummary != null  and errorSummary != ''"> and error_summary = #{errorSummary}</if>
        </where>
    </select>
    
    <select id="selectBizImportBatchById" parameterType="Long" resultMap="BizImportBatchResult">
        <include refid="selectBizImportBatchVo"/>
        where id = #{id}
    </select>

    <insert id="insertBizImportBatch" parameterType="BizImportBatch" useGeneratedKeys="true" keyProperty="id">
        insert into biz_import_batch
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="batchNo != null and batchNo != ''">batch_no,</if>
            <if test="importType != null and importType != ''">import_type,</if>
            <if test="fileName != null">file_name,</if>
            <if test="fileUrl != null">file_url,</if>
            <if test="totalCount != null">total_count,</if>
            <if test="successCount != null">success_count,</if>
            <if test="failCount != null">fail_count,</if>
            <if test="status != null">status,</if>
            <if test="errorSummary != null">error_summary,</if>
            <if test="templateVersion != null">template_version,</if>
            <if test="sourceHash != null">source_hash,</if>
            <if test="operatorId != null">operator_id,</if>
            <if test="operatorName != null">operator_name,</if>
            <if test="confirmTokenHash != null">confirm_token_hash,</if>
            <if test="confirmedAt != null">confirmed_at,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="batchNo != null and batchNo != ''">#{batchNo},</if>
            <if test="importType != null and importType != ''">#{importType},</if>
            <if test="fileName != null">#{fileName},</if>
            <if test="fileUrl != null">#{fileUrl},</if>
            <if test="totalCount != null">#{totalCount},</if>
            <if test="successCount != null">#{successCount},</if>
            <if test="failCount != null">#{failCount},</if>
            <if test="status != null">#{status},</if>
            <if test="errorSummary != null">#{errorSummary},</if>
            <if test="templateVersion != null">#{templateVersion},</if>
            <if test="sourceHash != null">#{sourceHash},</if>
            <if test="operatorId != null">#{operatorId},</if>
            <if test="operatorName != null">#{operatorName},</if>
            <if test="confirmTokenHash != null">#{confirmTokenHash},</if>
            <if test="confirmedAt != null">#{confirmedAt},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateBizImportBatch" parameterType="BizImportBatch">
        update biz_import_batch
        <trim prefix="SET" suffixOverrides=",">
            <if test="batchNo != null and batchNo != ''">batch_no = #{batchNo},</if>
            <if test="importType != null and importType != ''">import_type = #{importType},</if>
            <if test="fileName != null">file_name = #{fileName},</if>
            <if test="fileUrl != null">file_url = #{fileUrl},</if>
            <if test="totalCount != null">total_count = #{totalCount},</if>
            <if test="successCount != null">success_count = #{successCount},</if>
            <if test="failCount != null">fail_count = #{failCount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="errorSummary != null">error_summary = #{errorSummary},</if>
            <if test="templateVersion != null">template_version = #{templateVersion},</if>
            <if test="sourceHash != null">source_hash = #{sourceHash},</if>
            <if test="operatorId != null">operator_id = #{operatorId},</if>
            <if test="operatorName != null">operator_name = #{operatorName},</if>
            <if test="confirmTokenHash != null">confirm_token_hash = #{confirmTokenHash},</if>
            <if test="confirmedAt != null">confirmed_at = #{confirmedAt},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteBizImportBatchById" parameterType="Long">
        delete from biz_import_batch where id = #{id}
    </delete>

    <delete id="deleteBizImportBatchByIds" parameterType="String">
        delete from biz_import_batch where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 条件更新：待确认→已导入，落确认时间。where status=#{expectedStatus} 保证原子性与幂等 -->
    <update id="markConfirmed">
        update biz_import_batch
        set status = #{targetStatus}, confirmed_at = now(), update_by = #{operator}, update_time = now()
        where id = #{id} and status = #{expectedStatus}
    </update>

    <!-- 条件更新批次状态（不落确认时间）：0→1 预检完成、1→4 确认失败 -->
    <update id="markStatus">
        update biz_import_batch
        set status = #{targetStatus}, update_by = #{operator}, update_time = now()
        where id = #{id} and status = #{expectedStatus}
    </update>

    <!-- 文件去重：同类型 + 源哈希、且已导入(2) 的批次数（阻断/放弃的历史批次不计） -->
    <select id="countConfirmedBySource" resultType="int">
        select count(1) from biz_import_batch
        where import_type = #{importType}
          and source_hash = #{sourceHash}
          and status = 2
    </select>
</mapper>