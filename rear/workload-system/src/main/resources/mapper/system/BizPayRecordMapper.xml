<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.workload.system.mapper.BizPayRecordMapper">
    
    <resultMap type="BizPayRecord" id="BizPayRecordResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="semester"    column="semester"    />
        <result property="summaryId"    column="summary_id"    />
        <result property="courseHourPay"    column="course_hour_pay"    />
        <result property="otherPayTotal"    column="other_pay_total"    />
        <result property="totalPay"    column="total_pay"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectBizPayRecordVo">
        select id, user_id, semester, summary_id, course_hour_pay, other_pay_total, total_pay, status, create_by, create_time, update_by, update_time, remark from biz_pay_record
    </sql>

    <select id="selectBizPayRecordList" parameterType="BizPayRecord" resultMap="BizPayRecordResult">
        <include refid="selectBizPayRecordVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="semester != null  and semester != ''"> and semester = #{semester}</if>
            <if test="summaryId != null "> and summary_id = #{summaryId}</if>
            <if test="courseHourPay != null "> and course_hour_pay = #{courseHourPay}</if>
            <if test="otherPayTotal != null "> and other_pay_total = #{otherPayTotal}</if>
            <if test="totalPay != null "> and total_pay = #{totalPay}</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectBizPayRecordById" parameterType="Long" resultMap="BizPayRecordResult">
        <include refid="selectBizPayRecordVo"/>
        where id = #{id}
    </select>

    <insert id="insertBizPayRecord" parameterType="BizPayRecord" useGeneratedKeys="true" keyProperty="id">
        insert into biz_pay_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="semester != null and semester != ''">semester,</if>
            <if test="summaryId != null">summary_id,</if>
            <if test="courseHourPay != null">course_hour_pay,</if>
            <if test="otherPayTotal != null">other_pay_total,</if>
            <if test="totalPay != null">total_pay,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="semester != null and semester != ''">#{semester},</if>
            <if test="summaryId != null">#{summaryId},</if>
            <if test="courseHourPay != null">#{courseHourPay},</if>
            <if test="otherPayTotal != null">#{otherPayTotal},</if>
            <if test="totalPay != null">#{totalPay},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateBizPayRecord" parameterType="BizPayRecord">
        update biz_pay_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="semester != null and semester != ''">semester = #{semester},</if>
            <if test="summaryId != null">summary_id = #{summaryId},</if>
            <if test="courseHourPay != null">course_hour_pay = #{courseHourPay},</if>
            <if test="otherPayTotal != null">other_pay_total = #{otherPayTotal},</if>
            <if test="totalPay != null">total_pay = #{totalPay},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteBizPayRecordById" parameterType="Long">
        delete from biz_pay_record where id = #{id}
    </delete>

    <delete id="deleteBizPayRecordByIds" parameterType="String">
        delete from biz_pay_record where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>