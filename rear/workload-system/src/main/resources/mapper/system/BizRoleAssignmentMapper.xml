            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteBizRoleAssignmentById" parameterType="Long">
        delete from biz_role_assignment where id = #{id}
    </delete>

    <delete id="deleteBizRoleAssignmentByIds" parameterType="String">
        delete from biz_role_assignment where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
