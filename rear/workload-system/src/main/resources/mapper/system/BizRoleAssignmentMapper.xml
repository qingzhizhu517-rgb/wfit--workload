    <sql id="selectBizRoleAssignmentVo">
        select id, user_id, role_type, target, start_date, end_date, semester, academic_year, allowance_rate, status, create_by, create_time, update_by, update_time, remark from biz_role_assignment
    </sql>

    <select id="selectBizRoleAssignmentList" parameterType="BizRoleAssignment" resultMap="BizRoleAssignmentResult">
        <include refid="selectBizRoleAssignmentVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="roleType != null  and roleType != ''"> and role_type = #{roleType}</if>
            <if test="target != null  and target != ''"> and target = #{target}</if>
            <if test="startDate != null "> and start_date = #{startDate}</if>
            <if test="endDate != null "> and end_date = #{endDate}</if>
            <if test="semester != null  and semester != ''"> and semester = #{semester}</if>
            <if test="academicYear != null  and academicYear != ''"> and academic_year = #{academicYear}</if>
            <if test="allowanceRate != null "> and allowance_rate = #{allowanceRate}</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectBizRoleAssignmentById" parameterType="Long" resultMap="BizRoleAssignmentResult">
        <include refid="selectBizRoleAssignmentVo"/>
        where id = #{id}
    </select>

    <insert id="insertBizRoleAssignment" parameterType="BizRoleAssignment" useGeneratedKeys="true" keyProperty="id">
        insert into biz_role_assignment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="roleType != null and roleType != ''">role_type,</if>
            <if test="target != null">target,</if>
            <if test="startDate != null">start_date,</if>
            <if test="endDate != null">end_date,</if>
            <if test="semester != null">semester,</if>
            <if test="academicYear != null">academic_year,</if>
            <if test="allowanceRate != null">allowance_rate,</if>
