<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.workload.system.mapper.BizWlPracticeMapper">
    
    <resultMap type="BizWlPractice" id="BizWlPracticeResult">
        <result property="itemId"    column="item_id"    />
        <result property="J2"    column="J2"    />
        <result property="K"    column="K"    />
        <result property="C2"    column="C2"    />
        <result property="Q1"    column="Q1"    />
        <result property="Q2"    column="Q2"    />
        <result property="Q3"    column="Q3"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectBizWlPracticeVo">
        select item_id, J2, K, C2, Q1, Q2, Q3, create_by, create_time, update_by, update_time, remark from biz_wl_practice
    </sql>

    <select id="selectBizWlPracticeList" parameterType="BizWlPractice" resultMap="BizWlPracticeResult">
        <include refid="selectBizWlPracticeVo"/>
        <where>  
            <if test="J2 != null "> and J2 = #{J2}</if>
            <if test="K != null "> and K = #{K}</if>
            <if test="C2 != null "> and C2 = #{C2}</if>
            <if test="Q1 != null "> and Q1 = #{Q1}</if>
            <if test="Q2 != null "> and Q2 = #{Q2}</if>
            <if test="Q3 != null "> and Q3 = #{Q3}</if>
        </where>
    </select>
    
    <select id="selectBizWlPracticeByItemId" parameterType="Long" resultMap="BizWlPracticeResult">
        <include refid="selectBizWlPracticeVo"/>
        where item_id = #{itemId}
    </select>

    <insert id="insertBizWlPractice" parameterType="BizWlPractice">
        insert into biz_wl_practice
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="itemId != null">item_id,</if>
            <if test="J2 != null">J2,</if>
            <if test="K != null">K,</if>
            <if test="C2 != null">C2,</if>
            <if test="Q1 != null">Q1,</if>
            <if test="Q2 != null">Q2,</if>
            <if test="Q3 != null">Q3,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="itemId != null">#{itemId},</if>
            <if test="J2 != null">#{J2},</if>
            <if test="K != null">#{K},</if>
            <if test="C2 != null">#{C2},</if>
            <if test="Q1 != null">#{Q1},</if>
            <if test="Q2 != null">#{Q2},</if>
            <if test="Q3 != null">#{Q3},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateBizWlPractice" parameterType="BizWlPractice">
        update biz_wl_practice
        <trim prefix="SET" suffixOverrides=",">
            <if test="J2 != null">J2 = #{J2},</if>
            <if test="K != null">K = #{K},</if>
            <if test="C2 != null">C2 = #{C2},</if>
            <if test="Q1 != null">Q1 = #{Q1},</if>
            <if test="Q2 != null">Q2 = #{Q2},</if>
            <if test="Q3 != null">Q3 = #{Q3},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where item_id = #{itemId}
    </update>

    <delete id="deleteBizWlPracticeByItemId" parameterType="Long">
        delete from biz_wl_practice where item_id = #{itemId}
    </delete>

    <delete id="deleteBizWlPracticeByItemIds" parameterType="String">
        delete from biz_wl_practice where item_id in 
        <foreach item="itemId" collection="array" open="(" separator="," close=")">
            #{itemId}
        </foreach>
    </delete>
</mapper>