<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.workload.system.mapper.BizWorkloadCategoryDictMapper">
    
    <resultMap type="BizWorkloadCategoryDict" id="BizWorkloadCategoryDictResult">
        <result property="typeCode"    column="type_code"    />
        <result property="typeName"    column="type_name"    />
        <result property="parentGroup"    column="parent_group"    />
        <result property="calcStrategy"    column="calc_strategy"    />
        <result property="isCalcExcess"    column="is_calc_excess"    />
        <result property="sortOrder"    column="sort_order"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectBizWorkloadCategoryDictVo">
        select type_code, type_name, parent_group, calc_strategy, is_calc_excess, sort_order, status, create_by, create_time, update_by, update_time, remark from biz_workload_category_dict
    </sql>

    <select id="selectBizWorkloadCategoryDictList" parameterType="BizWorkloadCategoryDict" resultMap="BizWorkloadCategoryDictResult">
        <include refid="selectBizWorkloadCategoryDictVo"/>
        <where>  
            <if test="typeName != null  and typeName != ''"> and type_name like concat('%', #{typeName}, '%')</if>
            <if test="parentGroup != null  and parentGroup != ''"> and parent_group = #{parentGroup}</if>
            <if test="calcStrategy != null  and calcStrategy != ''"> and calc_strategy = #{calcStrategy}</if>
            <if test="isCalcExcess != null "> and is_calc_excess = #{isCalcExcess}</if>
            <if test="sortOrder != null "> and sort_order = #{sortOrder}</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectBizWorkloadCategoryDictByTypeCode" parameterType="String" resultMap="BizWorkloadCategoryDictResult">
        <include refid="selectBizWorkloadCategoryDictVo"/>
        where type_code = #{typeCode}
    </select>

    <insert id="insertBizWorkloadCategoryDict" parameterType="BizWorkloadCategoryDict">
        insert into biz_workload_category_dict
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="typeCode != null">type_code,</if>
            <if test="typeName != null and typeName != ''">type_name,</if>
            <if test="parentGroup != null and parentGroup != ''">parent_group,</if>
            <if test="calcStrategy != null">calc_strategy,</if>
            <if test="isCalcExcess != null">is_calc_excess,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="typeCode != null">#{typeCode},</if>
            <if test="typeName != null and typeName != ''">#{typeName},</if>
            <if test="parentGroup != null and parentGroup != ''">#{parentGroup},</if>
            <if test="calcStrategy != null">#{calcStrategy},</if>
            <if test="isCalcExcess != null">#{isCalcExcess},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateBizWorkloadCategoryDict" parameterType="BizWorkloadCategoryDict">
        update biz_workload_category_dict
        <trim prefix="SET" suffixOverrides=",">
            <if test="typeName != null and typeName != ''">type_name = #{typeName},</if>
            <if test="parentGroup != null and parentGroup != ''">parent_group = #{parentGroup},</if>
            <if test="calcStrategy != null">calc_strategy = #{calcStrategy},</if>
            <if test="isCalcExcess != null">is_calc_excess = #{isCalcExcess},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where type_code = #{typeCode}
    </update>

    <delete id="deleteBizWorkloadCategoryDictByTypeCode" parameterType="String">
        delete from biz_workload_category_dict where type_code = #{typeCode}
    </delete>

    <delete id="deleteBizWorkloadCategoryDictByTypeCodes" parameterType="String">
        delete from biz_workload_category_dict where type_code in 
        <foreach item="typeCode" collection="array" open="(" separator="," close=")">
            #{typeCode}
        </foreach>
    </delete>
</mapper>