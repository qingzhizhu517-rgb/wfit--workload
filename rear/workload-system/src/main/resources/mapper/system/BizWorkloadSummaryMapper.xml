            <if test="basicTeachingMet != null "> and basic_teaching_met = #{basicTeachingMet}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="teacherSign != null  and teacherSign != ''"> and teacher_sign = #{teacherSign}</if>
            <if test="teacherSignTime != null "> and teacher_sign_time = #{teacherSignTime}</if>
            <if test="deptLeaderSign != null  and deptLeaderSign != ''"> and dept_leader_sign = #{deptLeaderSign}</if>
            <if test="deptLeaderSignTime != null "> and dept_leader_sign_time = #{deptLeaderSignTime}</if>
            <if test="academicAssistantSign != null  and academicAssistantSign != ''"> and academic_assistant_sign = #{academicAssistantSign}</if>
            <if test="academicAssistantSignTime != null "> and academic_assistant_sign_time = #{academicAssistantSignTime}</if>
            <if test="lockTime != null "> and lock_time = #{lockTime}</if>
        </where>
    </select>
    
    <select id="selectBizWorkloadSummaryById" parameterType="Long" resultMap="BizWorkloadSummaryResult">
