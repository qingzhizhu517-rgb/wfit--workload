    <sql id="selectBizWorkloadSummaryVo">
        select id, user_id, semester, academic_year, G7, G8, G9, G10, G11, total_workload, rated_workload, excess_workload, title, pay_rate, performance_pay, is_capped, basic_teaching_standard, basic_teaching_met, status, teacher_sign, teacher_sign_time, dept_leader_sign, dept_leader_sign_time, academic_assistant_sign, academic_assistant_sign_time, lock_time, create_by, create_time, update_by, update_time, remark from biz_workload_summary
